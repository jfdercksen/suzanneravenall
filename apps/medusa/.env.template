# ── Medusa v2 environment variables ──────────────────────────────────────────
# Copy this file to .env.local for local development.
# Never commit .env or .env.local — they contain real secrets.

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/medusa

# HTTP secrets — must be at least 32 characters in production
JWT_SECRET=change_me_32_char_random_string
COOKIE_SECRET=change_me_32_char_random_string

# CORS — comma-separated origins allowed to access the Admin and Store APIs
ADMIN_CORS=http://localhost:7001
STORE_CORS=http://localhost:3000
AUTH_CORS=http://localhost:7001,http://localhost:3000

# Medusa Admin onboarding
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Seed script credentials (used by src/scripts/seed.ts only)
MEDUSA_ADMIN_EMAIL=admin@suzanneravenall.com
MEDUSA_ADMIN_PASSWORD=change_me_strong_password

# Error tracking
SENTRY_DSN=
