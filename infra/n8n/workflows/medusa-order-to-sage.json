        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ID: 0, Name: $json.customerName, ContactName: $json.customerName, Email: $json.customerEmail, Active: true, AcceptsElectronicInvoices: true }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0007-0000-0000-000000000007",
      "name": "Sage: Create Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 320],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Merge customer ID from both branches (found or newly created).\n// Passes all prep data forward.\nconst customerFound = $('IF: Customer Exists?').first().json;\nconst newCustomer = $input.first().json;\n\nconst customerId = newCustomer.ID ?? customerFound.customerId;\n\nreturn [{\n  json: {\n    ...customerFound,\n    customerId,\n  }\n}];"
      },
      "id": "a1b2c3d4-0008-0000-0000-000000000008",
      "name": "Merge: Set Customer ID",
