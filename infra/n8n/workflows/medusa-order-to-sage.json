      "id": "a1b2c3d4-0009b-000-0000-000000000009",
      "name": "Sage: Get Chart of Accounts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 400],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "passThrough",
        "output": "input1"
      },
      "id": "a1b2c3d4-0009c-000-0000-000000000009",
      "name": "Merge: Tax + Accounts",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [2220, 300]
    },
    {
      "parameters": {
        "jsCode": "// Resolve default tax type ID (15% VAT) and income account ID,\n// then build the invoice payload.\nconst prep = $('Merge: Set Customer ID').first().json;\nconst taxTypes = $('Sage: Get Tax Types').first().json?.Results ?? [];\nconst accounts = $('Sage: Get Chart of Accounts').first().json?.Results ?? [];\n\nconst taxType =\n  taxTypes.find(t => t.IsDefault && t.Active) ??\n  taxTypes.find(t => t.Percentage === 15 && t.Active);\n\nif (!taxType) throw new Error('Sage: no active VAT tax type found for company');\n\nconst incomeAccount =\n  accounts.find(a => a.Active && a.Category?.Description?.toLowerCase().includes('income') && /sale|revenue|income|service/i.test(a.Name)) ??\n  accounts.find(a => a.Active && a.Category?.Description?.toLowerCase().includes('income'));\n\nif (!incomeAccount) throw new Error('Sage: no income ledger account found in chart of accounts');\n\nconst today = new Date().toISOString().slice(0, 10);\n\nconst lines = prep.items.map(item => {\n  const productTitle = item.variant?.product?.title ?? item.title;\n  const variantTitle = item.variant?.title;\n  const description = variantTitle ? productTitle + ' — ' + variantTitle : productTitle;\n  const unitPriceZar = item.unit_price / 100;\n\n  return {\n    ID: 0,\n    LineType: 1,\n    SelectionId: incomeAccount.ID,\n    TaxTypeId: taxType.ID,\n    Description: description,\n    Quantity: item.quantity,\n    UnitPriceInclusive: unitPriceZar,\n    DiscountPercentage: 0,\n  };\n});\n\nconst invoicePayload = {\n  ID: 0,\n  CustomerId: prep.customerId,\n  Date: today,\n  DueDate: today,\n  Inclusive: true,\n  Reference: prep.displayId ? 'ORDER-' + prep.displayId : prep.orderId,\n  Message: 'Thank you for your purchase.',\n  Lines: lines,\n};\n\nreturn [{\n  json: {\n    ...prep,\n    invoicePayload,\n    taxTypeId: taxType.ID,\n    incomeAccountId: incomeAccount.ID,\n  }\n}];"
      },
      "id": "a1b2c3d4-0010-0000-0000-000000000010",
      "name": "Build: Invoice Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 300]
    },
    {
      "parameters": {
