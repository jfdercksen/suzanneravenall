              "fullResponse": false
            }
          }
        }
      },
      "id": "a1b2c3d4-0004-0000-0000-000000000004",
      "name": "Sage: Search Customers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Find customer by email in paginated results.\n// Returns { customerId, customerFound } for downstream nodes.\nconst prep = $('Prepare: Extract Order + Build Auth').first().json;\nconst email = prep.customerEmail?.toLowerCase().trim();\nconst results = $input.first().json?.Results ?? [];\n\nconst match = results.find(c => c.Email?.toLowerCase().trim() === email);\n\nreturn [{\n  json: {\n    ...prep,\n    customerId: match?.ID ?? null,\n    customerFound: !!match,\n  }\n}];"
      },
      "id": "a1b2c3d4-0005-0000-0000-000000000005",
      "name": "Find: Customer By Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "customer-found",
              "leftValue": "={{ $json.customerFound }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
