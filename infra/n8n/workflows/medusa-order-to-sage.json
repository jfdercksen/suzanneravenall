    {
      "parameters": {
        "jsCode": "// Extract order fields and build Sage Basic Auth header\nconst order = $input.first().json;\nconst email = $env.SAGE_EMAIL;\nconst password = $env.SAGE_PASSWORD;\nconst authHeader = 'Basic ' + Buffer.from(email + ':' + password).toString('base64');\n\nconst customerName = [\n  order.customer?.first_name,\n  order.customer?.last_name\n].filter(Boolean).join(' ') || order.customer?.email || 'Unknown';\n\nreturn [{\n  json: {\n    orderId: order.id,\n    displayId: order.display_id,\n    customerEmail: order.customer?.email,\n    customerName,\n    items: order.items,\n    totalCents: order.total,\n    currencyCode: order.currency_code,\n    authHeader,\n    apiKey: $env.SAGE_API_KEY,\n    companyId: $env.SAGE_COMPANY_ID,\n    sageBaseUrl: $env.SAGE_API_URL || 'https://accounting.sageone.co.za/api/2.0.0',\n  }\n}];"
      },
      "id": "a1b2c3d4-0003-0000-0000-000000000003",
      "name": "Prepare: Extract Order + Build Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 200]
    },
    {
