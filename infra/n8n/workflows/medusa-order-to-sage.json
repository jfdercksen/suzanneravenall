      "id": "a1b2c3d4-0011-0000-0000-000000000011",
      "name": "Sage: Create Invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2660, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Extract Sage invoice ID and prepare Medusa metadata update.\nconst invoice = $input.first().json;\nconst prep = $('Build: Invoice Payload').first().json;\n\nif (!invoice.ID) throw new Error('Sage invoice created but no ID returned: ' + JSON.stringify(invoice).slice(0, 200));\n\nreturn [{\n  json: {\n    ...prep,\n    sageInvoiceId: String(invoice.ID),\n    sageDocumentNumber: invoice.DocumentNumber,\n    sageTotal: invoice.Total,\n  }\n}];"
      },
      "id": "a1b2c3d4-0012-0000-0000-000000000012",
      "name": "Extract: Invoice ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2880, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://medusa:9000/admin/orders/' + $json.orderId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-medusa-access-token",
              "value": "={{ $env.MEDUSA_API_TOKEN || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ metadata: { sage_invoice_id: $json.sageInvoiceId, sage_document_number: $json.sageDocumentNumber, sage_synced_at: new Date().toISOString() } }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0013-0000-0000-000000000013",
      "name": "Medusa: Update Order Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3100, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Success — log confirmation.\nconst prev = $('Extract: Invoice ID').first().json;\nconsole.log('[sage-sync] SUCCESS order=' + prev.orderId + ' sageInvoiceId=' + prev.sageInvoiceId + ' doc=' + prev.sageDocumentNumber);\nreturn [$input.first()];"
      },
      "id": "a1b2c3d4-0014-0000-0000-000000000014",
      "name": "Done: Log Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3320, 300]
    },
    {
      "parameters": {
        "jsCode": "// Error handler — called on any Sage or Medusa API failure.\n// Logs the error and sends an alert email via Resend.\n// Returns the error info so it can be passed to the email node.\nconst errItem = $input.first();\nconst errorMessage = errItem.error?.message ?? errItem.json?.message ?? 'Unknown error';\n\n// Try to get order context from any available upstream node\nlet orderId = 'unknown';\ntry { orderId = $('Prepare: Extract Order + Build Auth').first().json.orderId ?? 'unknown'; } catch {}\n\nconsole.error('[sage-sync] ERROR order=' + orderId + ' error=' + errorMessage);\n\nreturn [{\n  json: {\n    orderId,\n    errorMessage,\n    subject: '[ALERT] Sage sync failed for order ' + orderId,\n    timestamp: new Date().toISOString(),\n  }\n}];"
      },
      "id": "a1b2c3d4-0015-0000-0000-000000000015",
      "name": "Error: Log and Prepare Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.RESEND_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'noreply@suzanneravenall.com', to: ['admin@suzanneravenall.com'], subject: $json.subject, html: '<p><strong>Sage sync failed.</strong></p><p>Order ID: ' + $json.orderId + '</p><p>Error: ' + $json.errorMessage + '</p><p>Time: ' + $json.timestamp + '</p><p>Manual recovery required — create invoice in Sage and update Medusa order metadata.</p>' }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0016-0000-0000-000000000016",
      "name": "Alert: Send Error Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2220, 600],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Workflow ends cleanly — error was logged and alerted.\n// Returning success so this branch terminates without n8n error status.\nconsole.log('[sage-sync] error handled and alerted, workflow complete');\nreturn [$input.first()];"
      },
      "id": "a1b2c3d4-0017-0000-0000-000000000017",
      "name": "Done: Error Handled",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 600]
    },
    {
      "parameters": {
        "content": "## Medusa Order → Sage Invoice\\n\\n**Trigger:** POST /webhook/medusa-order-placed\\n**Response:** 200 immediately (never blocks Medusa)\\n\\n**Required env vars in n8n container:**\\n- SAGE_EMAIL\\n- SAGE_PASSWORD\\n- SAGE_API_KEY\\n- SAGE_COMPANY_ID\\n- SAGE_API_URL (default: https://accounting.sageone.co.za/api/2.0.0)\\n- MEDUSA_API_TOKEN (admin API token)\\n- RESEND_API_KEY\\n\\n**Sage SA v2.0.0 — Basic Auth (not OAuth)**\\nThe SA v2 API uses Basic Auth + apikey query param.\\nNo OAuth token endpoint is used.\\n\\n**Error policy:**\\nAny Sage failure → alert email via Resend → continue.\\nOrder is NEVER blocked by Sage errors.",
        "height": 360,
        "width": 480,
        "color": 4
      },
      "id": "a1b2c3d4-0018-0000-0000-000000000018",
      "name": "Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, 560]
    }
