{
  "name": "Membership Expiry Check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "me000001-0000-0000-0000-000000000001",
      "name": "Schedule: Daily 09:00 SAST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "notes": "09:00 SAST = 07:00 UTC. Adjust if server timezone differs."
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/member_subscriptions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "user_id,tier_slug,expires_at,profiles(first_name,email)"
            },
            {
              "name": "status",
              "value": "eq.active"
            },
            {
              "name": "expires_at",
              "value": "=lte.{{ new Date().toISOString() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "me000001-0000-0000-0000-000000000002",
      "name": "Supabase: Get Expired Active Memberships",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-email",
              "leftValue": "={{ $json.profiles?.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "me000001-0000-0000-0000-000000000003",
      "name": "IF: Has Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/member_subscriptions",
        "method": "PATCH",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "user_id",
              "value": "=eq.{{ $json.user_id }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "expired"
            }
          ]
        },
        "options": {}
      },
      "id": "me000001-0000-0000-0000-000000000004",
      "name": "Supabase: Set Status to Expired",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/email/membership-expired",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-webhook-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ $('IF: Has Email').item.json.profiles.email }}"
            },
            {
              "name": "firstName",
              "value": "={{ $('IF: Has Email').item.json.profiles.first_name ?? null }}"
            },
            {
              "name": "tier",
              "value": "={{ $('IF: Has Email').item.json.tier_slug }}"
            }
          ]
        },
        "options": {}
      },
      "id": "me000001-0000-0000-0000-000000000005",
      "name": "POST: Send Expiry Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconsole.error('[membership-expiry] Error for user', item.user_id, ':', $error?.message ?? 'unknown');\nreturn [{ json: { logged: true, userId: item.user_id } }];"
      },
      "id": "me000001-0000-0000-0000-000000000006",
      "name": "Error: Log Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 420],
      "notes": "TODO: Wire to Sentry or alert channel once error DSNs are configured (Phase 5)"
    }
  ],
  "connections": {
    "Schedule: Daily 09:00 SAST": {
      "main": [
        [
          {
            "node": "Supabase: Get Expired Active Memberships",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase: Get Expired Active Memberships": {
      "main": [
        [
          {
            "node": "IF: Has Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: Has Email": {
      "main": [
        [
          {
            "node": "Supabase: Set Status to Expired",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error: Log Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase: Set Status to Expired": {
      "main": [
        [
          {
            "node": "POST: Send Expiry Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["membership", "email", "scheduled"]
}
