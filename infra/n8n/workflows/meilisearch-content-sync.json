{
  "name": "MeiliSearch Content Sync",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "product-updated",
        "responseMode": "onReceived",
        "responseCode": 200,
        "responseData": "noData",
        "options": {}
      },
      "id": "ms000001-0000-0000-0000-000000000001",
      "name": "Webhook: Product Updated",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 200],
      "webhookId": "product-updated"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "check-product-id",
              "leftValue": "={{ $json.productId }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "ms000001-0000-0000-0000-000000000002",
      "name": "Check: Has Product ID",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MEDUSA_BACKEND_URL }}/admin/products/{{ $json.productId }}?fields=id,handle,title,description,thumbnail,status,*variants,*variants.prices,*categories,*collection",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.MEDUSA_API_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "ms000001-0000-0000-0000-000000000003",
      "name": "Medusa: Fetch Product",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 160]
    },
    {
      "parameters": {
        "jsCode": "const product = $input.item.json.product;\nif (!product) throw new Error('No product in Medusa response');\n\nconst zarPrices = (product.variants || [])\n  .flatMap(v => v.prices || [])\n  .filter(p => p.currency_code === 'zar')\n  .map(p => p.amount);\n\nconst priceZar = zarPrices.length > 0 ? Math.min(...zarPrices) : null;\n\nreturn [{\n  json: {\n    id: product.id,\n    handle: product.handle,\n    title: product.title,\n    description: product.description,\n    thumbnail: product.thumbnail,\n    status: product.status,\n    price_zar: priceZar,\n    collection_id: product.collection?.id ?? null,\n    collection_handle: product.collection?.handle ?? null,\n    collection_title: product.collection?.title ?? null,\n    category_ids: (product.categories || []).map(c => c.id),\n    category_names: (product.categories || []).map(c => c.name),\n    variant_titles: (product.variants || []).map(v => v.title).join(' '),\n  }\n}];"
      },
      "id": "ms000001-0000-0000-0000-000000000004",
      "name": "Transform: Product Document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MEILISEARCH_HOST }}/indexes/products/documents",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.MEILISEARCH_ADMIN_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([$json]) }}",
        "options": {}
      },
      "id": "ms000001-0000-0000-0000-000000000005",
      "name": "MeiliSearch: Upsert Product",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 160]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "id": "ms000001-0000-0000-0000-000000000006",
      "name": "Schedule: Daily 2am SAST (midnight UTC)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 420]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MEDUSA_BACKEND_URL }}/admin/products?limit=500&fields=id,handle,title,description,thumbnail,status,*variants,*variants.prices,*categories,*collection&status[]=published",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.MEDUSA_API_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "ms000001-0000-0000-0000-000000000007",
      "name": "Medusa: Fetch All Products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 420]
    },
    {
      "parameters": {
        "jsCode": "const products = $input.item.json.products || [];\n\nreturn products.map(product => {\n  const zarPrices = (product.variants || [])\n    .flatMap(v => v.prices || [])\n    .filter(p => p.currency_code === 'zar')\n    .map(p => p.amount);\n\n  const priceZar = zarPrices.length > 0 ? Math.min(...zarPrices) : null;\n\n  return {\n    json: {\n      id: product.id,\n      handle: product.handle,\n      title: product.title,\n      description: product.description,\n      thumbnail: product.thumbnail,\n      status: product.status,\n      price_zar: priceZar,\n      collection_id: product.collection?.id ?? null,\n      collection_handle: product.collection?.handle ?? null,\n      collection_title: product.collection?.title ?? null,\n      category_ids: (product.categories || []).map(c => c.id),\n      category_names: (product.categories || []).map(c => c.name),\n      variant_titles: (product.variants || []).map(v => v.title).join(' '),\n    }\n  };\n});"
      },
      "id": "ms000001-0000-0000-0000-000000000008",
      "name": "Transform: All Product Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 420]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.MEILISEARCH_HOST }}/indexes/products/documents",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.MEILISEARCH_ADMIN_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($input.all().map(i => i.json)) }}",
        "options": {}
      },
      "id": "ms000001-0000-0000-0000-000000000009",
      "name": "MeiliSearch: Replace All Products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 420]
    }
  ],
