# ============================================================
# suzanneravenall.com — VPS production environment
# Copy this file to infra/.env and fill in real values.
# This file is read by docker compose — never commit infra/.env
# ============================================================

# ============================================================
# PostgreSQL — shared Postgres instance (Medusa, n8n, Cal.com)
# ============================================================
POSTGRES_DB=medusa
POSTGRES_USER=medusa
POSTGRES_PASSWORD=change_me_strong_password

# ============================================================
# Medusa.js v2 — commerce backend
# Uses the "medusa" database on the shared Postgres instance
# ============================================================
MEDUSA_DATABASE_URL=postgres://medusa:change_me_strong_password@postgres:5432/medusa
NODE_ENV=production
JWT_SECRET=change_me_jwt_secret_min_32_chars
COOKIE_SECRET=change_me_cookie_secret_min_32_chars
MEDUSA_ADMIN_ONBOARDING_TYPE=default
SENTRY_DSN_MEDUSA=https://your-key@sentry.io/your-medusa-project-id
# ── Medusa (Task 2.1) ────────────────────────────────────────────────────────
ADMIN_CORS=http://localhost:7001,http://169.239.180.49
STORE_CORS=http://localhost:3000,http://169.239.180.49
AUTH_CORS=http://localhost:7001,http://localhost:3000,http://169.239.180.49
MEDUSA_ADMIN_EMAIL=admin@suzanneravenall.com
MEDUSA_ADMIN_PASSWORD=change_me_strong_password

# ============================================================
# Payload CMS — content management
# Uses the "payload" database on the shared Postgres instance
# Run before first deploy:
#   docker exec suzanne_postgres psql -U medusa -c "CREATE DATABASE payload;"
# ============================================================
PAYLOAD_DATABASE_URL=postgres://medusa:change_me_strong_password@postgres:5432/payload
PAYLOAD_SECRET=change_me_payload_secret_min_32_chars
PAYLOAD_URL=https://suzanneravenall.com/cms

# ============================================================
# Next.js — public-facing website
# IMPORTANT: NEXT_PUBLIC_* vars bake into the browser bundle at Docker build time.
# They must be URLs a browser can reach — never internal Docker hostnames.
#
# NEXT_PUBLIC_MEDUSA_URL is the API base URL (Medusa JS SDK appends /store or /admin).
# Nginx rewrites /api/store/* → /store/* and /api/admin/* → /admin/* before proxying.
# IP testing:  http://169.239.180.49/api
# Production:  https://suzanneravenall.com/api   (update at DNS cutover)
# ============================================================
NEXT_PUBLIC_SITE_URL=https://suzanneravenall.com
NEXT_PUBLIC_SUPABASE_URL=https://mjhwonoekokxyisfljtj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_MEDUSA_URL=https://suzanneravenall.com/api
MEDUSA_BACKEND_URL=http://medusa:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=your-medusa-publishable-api-key
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=your-clarity-id
NEXT_PUBLIC_CAL_URL=https://cal.suzanneravenall.com
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-web-project-id
SENTRY_DSN_WEB=https://your-key@sentry.io/your-web-project-id
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ENVIRONMENT=production
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ============================================================
# Email — Resend
# ============================================================
RESEND_API_KEY=re_xxxxxxxxxxxx

# ============================================================
# Payments (Phase 2)
# ============================================================
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Webhook ID from developer.paypal.com — My Apps → Webhooks → Webhook ID
# Required for production webhook signature verification
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
# Set to true when using PayPal sandbox credentials (developer.paypal.com)
# false in production — never commit real credentials
PAYPAL_SANDBOX=false

# ============================================================
# Bunny Stream — video hosting (Phase 3)
# BUNNY_STREAM_API_KEY: Bunny.net API key (from Bunny dashboard → API)
# BUNNY_STREAM_LIBRARY_ID: Video library ID (from Stream → Library settings)
# BUNNY_STREAM_SIGNING_KEY: Token Auth Key for signed embed URLs (Stream → Library → Security)
#   If unset, falls back to BUNNY_STREAM_API_KEY — not recommended for production.
# BUNNY_CDN_HOSTNAME: Override embed hostname (default: iframe.mediadelivery.net)
# ============================================================
BUNNY_STREAM_API_KEY=your-bunny-api-key
BUNNY_STREAM_LIBRARY_ID=your-library-id
BUNNY_STREAM_SIGNING_KEY=your-bunny-token-auth-key
BUNNY_CDN_HOSTNAME=iframe.mediadelivery.net
# BUNNY_WEBHOOK_SECRET: Signing key for Bunny Stream webhook signature verification
#   Generate: openssl rand -hex 32
#   Set in Bunny dashboard → Stream → Library → Webhook → Signing Key
BUNNY_WEBHOOK_SECRET=your-bunny-webhook-secret

# Cal.com webhook — signature verification
# Generate: openssl rand -hex 32
# Set in Cal.com → Settings → Developer → Webhooks → Secret
CALCOM_WEBHOOK_SECRET=your-calcom-webhook-secret

# ============================================================
# MeiliSearch — search
# MEILI_MASTER_KEY is consumed by the meilisearch container.
# MEILISEARCH_HOST / MEILISEARCH_ADMIN_KEY are passed to the
# web container so it can query MeiliSearch internally.
# ============================================================
MEILI_MASTER_KEY=change_me_meilisearch_master_key
MEILI_ENV=production
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_ADMIN_KEY=change_me_meilisearch_master_key

# ============================================================
# n8n — automation
# ============================================================
N8N_ENCRYPTION_KEY=change_me_n8n_encryption_key
N8N_HOST=n8n.suzanneravenall.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.suzanneravenall.com
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=medusa
DB_POSTGRESDB_PASSWORD=change_me_strong_password
N8N_WEBHOOK_SECRET=change_me_n8n_webhook_secret
N8N_BASE_URL=http://n8n:5678

# ============================================================
# Cal.com — booking
# Note: Cal.com database URL is constructed inline in
# docker-compose using POSTGRES_PASSWORD — no separate var.
# Ensure "calcom" database exists before first run:
#   docker exec suzanne_postgres psql -U medusa -c "CREATE DATABASE calcom;"
# ============================================================
NEXT_PUBLIC_WEBAPP_URL=https://cal.suzanneravenall.com
CALENDSO_ENCRYPTION_KEY=change_me_calcom_encryption_key
NEXTAUTH_SECRET=change_me_nextauth_secret
NEXTAUTH_URL=https://cal.suzanneravenall.com
EMAIL_FROM=noreply@suzanneravenall.com
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=your_resend_api_key

# ============================================================
# Vtiger CRM (Phase 4)
# ============================================================
VTIGER_URL=https://your-vtiger-instance.com
VTIGER_USERNAME=your-vtiger-username
VTIGER_ACCESS_KEY=your-vtiger-access-key

# ============================================================
# Vibe Marketing (Ai Dynamic Advisory proprietary platform)
# Get webhook URL from Vibe Marketing dashboard (Johan to provide)
# Leave blank to disable — lead magnet and post-purchase webhooks
# will be skipped gracefully when this var is unset.
# ============================================================
VIBE_MARKETING_WEBHOOK_URL=

# ============================================================
# Sage Business Cloud API (Phase 2 — Task 2.8)
# South Africa v2.0.0 API — uses Basic Auth + API key (NOT OAuth)
# Base URL: https://accounting.sageone.co.za/api/2.0.0
# Auth URL: NOT used — SA v2 does not use oauth.accounting.sage.com
#
# To find your Company ID:
#   GET https://accounting.sageone.co.za/api/2.0.0/Company/Get?apikey={key}
#   Authorization: Basic <base64(email:password)>
#
# Used by:
#   - apps/medusa/src/modules/sage/ (SageService helper)
#   - infra/n8n/workflows/medusa-order-to-sage.json (n8n workflow)
#
# IMPORTANT: n8n also needs these vars set inside the n8n container.
# Add them to the n8n service environment in docker-compose.yml.
# ============================================================
SAGE_EMAIL=your-sage-login-email
SAGE_PASSWORD=your-sage-login-password
SAGE_API_KEY=your-sage-api-key
SAGE_COMPANY_ID=your-sage-company-id
SAGE_API_URL=https://accounting.sageone.co.za/api/2.0.0
# Recommended: set to your Sage income/sales ledger account ID (from Chart of Accounts)
# to avoid heuristic matching. Leave blank to use automatic detection.
SAGE_INCOME_ACCOUNT_ID=

# Medusa admin API token — used by n8n to update order metadata after invoice creation.
# Generate in Medusa admin: Settings → API Key Management → Create API Key
MEDUSA_API_TOKEN=your-medusa-admin-api-token

# n8n webhook base URL — used by Medusa subscriber to trigger the Sage workflow.
# Internal Docker hostname (medusa → n8n).
N8N_WEBHOOK_URL=http://n8n:5678

# ============================================================
# Anthropic — Claude API
# ============================================================
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# ============================================================
# Firecrawl — web scraping (used by Claude Code / dev tooling)
# ============================================================
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Backblaze B2 — automated backups
# ============================================================
B2_BUCKET_NAME=your-backblaze-bucket-name
B2_KEY_ID=your-backblaze-key-id
B2_APPLICATION_KEY=your-backblaze-application-key

# ============================================================
# Slack — deployment and backup failure notifications
# Also used in GitHub Actions deploy.yml (SLACK_WEBHOOK_URL secret)
# ============================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
